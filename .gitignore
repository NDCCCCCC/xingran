# ----------------------------------------------------------------------------
# 配置文件管理（重要）
# ----------------------------------------------------------------------------
# 真实环境配置（可能含密钥、内网地址）不提交到仓库
# 模板以 .example.yaml 后缀入库，开发者从模板 cp 出真实 config.yaml
# config.go:Load() 只加载 configs/config.yaml
#
# 例外（仍追踪）：configs/config.example.yaml, configs/config.prod.example.yaml
# ----------------------------------------------------------------------------
configs/config.yaml
configs/config.dev.yaml
configs/config.prod.yaml
configs/configbs.yaml       # 服务器下载的旧版备份（防止误提交）
configs/config*.local.yaml  # 本地覆盖
configs/config*.bak         # 备份副本

# 旧的错误条目清理
configs/config.prod.yamlnul

# Git Worktree 目录
.worktrees/

# 代码分析和优化报告
CODE_OPTIMIZATION_REPORT.md
COMMIT_GUIDE.md
cleanup_temp_files.ps1
cleanup_temp_files.sh

# SQL 修复脚本（临时）
fix_*.sql

# 数据目录
数据/
*.xlsx
*.png
# 例外：v1.24 Phase 77 视觉回归的验收证据图（17 张，共 ~456KB）必须入库，
# 否则「视觉验证已收口」的凭证只存在于本地工作区，评审与回溯时不可得。
!.planning/notes/v1.24-visual-evidence/
!.planning/notes/v1.24-visual-evidence/*.png
.trae/

# 调试残留归档（debug_*.js / temp-fix.sh 等临时脚本的归档，不入仓）
.archive/

# 运行时用户上传文件
uploads/

# 前端测试覆盖率输出
xingran-react-frontend/coverage/

# RPA Worker 运行时配置（含明文 Redis 密码 / 内网地址）
# 模板请使用 rpa-worker/configs/config.example.yaml
rpa-worker/configs/config.yaml

# HTML 原型调试残留（chrome-devtools 会话产物）
/655aa291-*/

# root-level accidental artifacts
cov_*.out

# 崩溃转储（Git Bash / bash.exe 残留）
*.stackdump

# 嵌入式后端构建产物（新旧命名均覆盖）
*-backend-embedded
*-backend-embedded-*

# 一次性生成数据（scripts/tmp_menuimport -mode=gen 可再生）
xingran_menus_dedup.sql

