# 开发环境配置

# API 地址 - 使用相对路径走 Vite dev server 代理 (vite.config.ts server.proxy /api → :9000)
# 原值 http://10.62.10.33:9000/api/v1 让浏览器按跨源请求发送 → 触发 CORS preflight OPTIONS
# → 后端 CORS middleware 不处理 workstation/export 等 ops 端点 → 浏览器 30s 默认超时
# → axios timeout → catch → "导出失败" toast
# 改相对路径后请求经 Vite proxy 中转，对浏览器同源 (127.0.0.1:4000) 无 CORS。
# 局域网其他电脑访问 dev 站点仍可工作：浏览器访问 http://10.62.10.33:4000，/api/v1 相对路径
# 由 Vite 代理到 127.0.0.1:9000 后端（同进程 loopback）。
VITE_API_BASE_URL=/api/v1

# 请求体加密开关（临时启用用于测试）
VITE_ENABLE_REQUEST_ENCRYPTION=true

# 百度地图 AK（用于楼宇空间 3D 可视化）
# 请在百度地图开放平台申请：https://lbsyun.baidu.com/
# 免费额度：5万次/日
VITE_BAIDU_MAP_AK=94Z13PIcFScTLXqT57demA7FidQcQApY
