import React, { useState, useEffect } from 'react';
import { Table, Button, Space, Modal, message, Form, Input, Slider, InputNumber, Card, Spin } from 'antd';
import { ReloadOutlined, DeleteOutlined } from '@ant-design/icons';
import { vmApi, vdiServerApi } from '@/lib/vdiApi';
import type { VirtualMachine, CreateVMRequest } from '@/types/vdi';

// ============================================================================
// VDI 虚拟机简化创建表单 - 硬编码默认值
// ============================================================================
// 默认值常量 - 根据 scripts/vdi_test_standalone.go 测试结果
const DEFAULT_VTP_ID = 1;              // VTP 平台 ID（VMP）
const DEFAULT_RESOURCE_GROUP_ID = '0'; // 默认资源组 ID
const DEFAULT_RESOURCE_NAME = '数据';   // 资源名称
const DEFAULT_POSITION_NAME = '研发';    // 运行位置名称
const DEFAULT_VDI_SERVER_NAME = '深信服VDI'; // VDI 服务器名称

const VirtualMachineListSimplified: React.FC = () => {
  const [loading, setLoading] = useState(false);
  const [vms, setVMs] = useState<VirtualMachine[]>([]);
  const [total, setTotal] = useState(0);
  const [current, setCurrent] = useState(1);
  const [pageSize, setPageSize] = useState(10);
  const [selectedRowKeys, setSelectedRowKeys] = useState<React.Key[]>([]);
  const [createModalVisible, setCreateModalVisible] = useState(false);
  const [form] = Form.useForm();

  // 隐藏的配置状态（用于自动填充）
  const [config, setConfig] = useState<{
    vdiServerId: string;
    resourceId: string;
    runPositionId: string;
    diskId: string;
    storageId: string;
    networkId: string;
    hostId: string;
  } | null>(null);

  // 加载虚拟机列表
  const loadVMs = async () => {
    setLoading(true);
    try {
      const result = await vmApi.list({ current, pageSize });
      setVMs(result.data?.list || []);
      setTotal(result.data?.total || 0);
    } catch (error) {
      message.error('加载虚拟机列表失败');
    } finally {
      setLoading(false);
    }
  };

  // 加载并自动选择默认配置
  const loadDefaults = async () => {
    try {
      console.log('[VDI Simplified] 开始加载默认配置...');

      // 1. 获取VDI服务器列表
      const serverResult = await vdiServerApi.list({ current: 1, pageSize: 100 });
      const servers = serverResult.data?.list || [];
      const availableServer = servers.find(s => s.status === 0);

      if (!availableServer) {
        message.error('没有可用的VDI服务器');
        return;
      }

      console.log('[VDI Simplified] VDI服务器:', availableServer.name, availableServer.id);

      // 2. 获取资源组（选择默认资源组ID=0）
      const resourceGroups = await vmApi.listResourceGroups(availableServer.id);
      const defaultGroup = resourceGroups.data?.find(g => g.resource_group_id === '0');

      if (!defaultGroup) {
        message.error('未找到默认资源组');
        return;
      }

      console.log('[VDI Simplified] 资源组:', defaultGroup.name);

      // 3. 获取资源列表（查找"数据"资源）
      const resources = await vmApi.listResources(availableServer.id, '0');
      const resourceList = resources.data || [];
      const dataResource = resourceList.find(r => r.name === DEFAULT_RESOURCE_NAME);

      if (!dataResource) {
        message.error(`未找到资源"${DEFAULT_RESOURCE_NAME}"，可用资源: ${resourceList.map(r => r.name).join(', ')}`);
        return;
      }

      console.log('[VDI Simplified] 资源:', dataResource.name, 'ID:', dataResource.id);

      // 4. 获取VTP平台（VMP, ID=1）
      const platforms = await vmApi.listVTPPlatforms(availableServer.id);
      const vmpPlatform = platforms.data?.find(p => p.name === 'VMP' || p.id === DEFAULT_VTP_ID);

      if (!vmpPlatform) {
        message.error('未找到VMP平台');
        return;
      }

      console.log('[VDI Simplified] VTP平台:', vmpPlatform.name, 'ID:', vmpPlatform.id);

      // 5. 获取运行位置（查找"研发"）
      const positions = await vmApi.listRunPositions(availableServer.id, vmpPlatform.id);
      const positionList = positions.data || [];
      const devPosition = positionList.find(p => p.name === DEFAULT_POSITION_NAME);

      if (!devPosition) {
        message.error(`未找到运行位置"${DEFAULT_POSITION_NAME}"，可用位置: ${positionList.map(p => p.name).join(', ')}`);
        return;
      }

      console.log('[VDI Simplified] 运行位置:', devPosition.name, 'ID:', devPosition.id, 'father_id:', devPosition.father_id);

      // 6. 获取存储位置（选择第一个）
      const storages = await vmApi.listStorages(availableServer.id, vmpPlatform.id);
      const storageList = storages.data || [];
      const firstStorage = storageList[0];

      if (!firstStorage) {
        message.error('未找到存储位置');
        return;
      }

      console.log('[VDI Simplified] 存储位置:', firstStorage.name, 'ID:', firstStorage.id);

      // 7. 获取网络接口（选择第一个）
      const networks = await vmApi.listNetworks(availableServer.id, vmpPlatform.id);
      const networkList = networks.data || [];
      const firstNetwork = networkList[0];

      if (!firstNetwork) {
        message.error('未找到网络接口');
        return;
      }

      console.log('[VDI Simplified] 网络接口:', firstNetwork.name, 'ID:', firstNetwork.id);

      // 保存配置
      setConfig({
        vdiServerId: availableServer.id,
        resourceId: String(dataResource.id),
        runPositionId: devPosition.id,
        diskId: firstStorage.id,
        storageId: firstStorage.id,
        networkId: firstNetwork.id,
        hostId: devPosition.father_id || devPosition.id,
      });

      // 自动设置表单默认值
      form.setFieldsValue({
        name: `VDI-${defaultGroup.name}-${dataResource.name}`,
        cpu_number: 1,
        memory: 8192,
        cpu_core: 4,
        disk: 80,
        count: 1,
      });

      message.success('默认配置加载成功！');
    } catch (error) {
      console.error('[VDI Simplified] 加载配置失败:', error);
      message.error('加载VDI配置失败，请检查网络连接和VDI服务器状态');
    }
  };

  // 打开创建模态框
  const openCreateModal = async () => {
    setCreateModalVisible(true);
    form.resetFields();
    await loadDefaults();
  };

  // 创建虚拟机
  const handleCreate = async () => {
    if (!config) {
      message.error('配置未加载，请重试');
      return;
    }

    try {
      const values = await form.validateFields();
      setLoading(true);

      // 根据 vdi_test_standalone.go 的逻辑处理 run_position_id
      let finalRunPositionId = config.runPositionId;
      if (config.runPositionId === config.hostId) {
        // id == father_id 时，run_position_id 应为空
        finalRunPositionId = '';
      }

      const data: CreateVMRequest = {
        vdi_server_id: config.vdiServerId,
        resource_group_id: DEFAULT_RESOURCE_GROUP_ID,
        resource_id: config.resourceId,
        vtp_id: DEFAULT_VTP_ID,
        host_id: config.hostId,
        run_position_id: finalRunPositionId,
        disk_id: config.diskId,
        storage_id: config.storageId,
        network_id: config.networkId,
        name: values.name,
        cpu_number: values.cpu_number,
        memory: values.memory,
        cpu_core: values.cpu_core,
        disk: values.disk,
        count: values.count,
      };

      console.log('[VDI Simplified] 创建请求参数:', data);

      await vmApi.create(data);
      message.success('虚拟机创建成功！');
      setCreateModalVisible(false);
      form.resetFields();
      loadVMs();
    } catch (error) {
      console.error('[VDI Simplified] 创建失败:', error);
      message.error('创建虚拟机失败');
    } finally {
      setLoading(false);
    }
  };

  const columns: any[] = [
    { title: 'VM ID', dataIndex: 'vm_id', key: 'vm_id' },
    { title: '名称', dataIndex: 'name', key: 'name' },
    { title: 'IP地址', dataIndex: 'ip_address', key: 'ip_address' },
    { title: 'MAC地址', dataIndex: 'mac_address', key: 'mac_address' },
    { title: '电源状态', dataIndex: 'power_state', key: 'power_state' },
    { title: '创建时间', dataIndex: 'created_at', key: 'created_at' },
  ];

  return (
    <Card title="VDI 虚拟机管理">
      <Space style={{ marginBottom: 16 }}>
        <Button type="primary" onClick={openCreateModal}>
          创建虚拟机（简化版）
        </Button>
        <Button icon={<ReloadOutlined />} onClick={loadVMs}>
          刷新
        </Button>
      </Space>

      <Table
        columns={columns}
        dataSource={vms}
        rowKey="vm_id"
        loading={loading}
        pagination={{
          current,
          pageSize,
          total,
          showSizeChanger: true,
          onChange: (page, size) => {
            setCurrent(page);
            setPageSize(size);
          },
        }}
      />

      {/* 简化创建模态框 */}
      <Modal
        title="创建虚拟机（简化版）"
        open={createModalVisible}
        onOk={handleCreate}
        onCancel={() => setCreateModalVisible(false)}
        confirmLoading={loading}
        width={600}
      >
        <Spin spinning={loading && !config} tip="加载配置中...">
          <Form form={form} layout="vertical">
            {config && (
              <div style={{ marginBottom: 16, padding: 12, background: '#f5f5f5', borderRadius: 4 }}>
                <div><strong>已加载的默认配置：</strong></div>
                <div style={{ marginTop: 8, fontSize: '12px', color: '#666' }}>
                  • VDI 服务器: {DEFAULT_VDI_SERVER_NAME}<br />
                  • 资源组: 默认资源组<br />
                  • 资源: {DEFAULT_RESOURCE_NAME}<br />
                  • VTP 平台: VMP<br />
                  • 运行位置: {DEFAULT_POSITION_NAME}<br />
                  • 存储/网络: 自动选择第一个可用
                </div>
              </div>
            )}

            <Form.Item
              label="虚拟机名称"
              name="name"
              rules={[{ required: true, message: '请输入虚拟机名称' }]}
              extra={`格式: VDI-默认资源组-${DEFAULT_RESOURCE_NAME}-自定义后缀`}
            >
              <Input placeholder={`例如: VDI-默认资源组-${DEFAULT_RESOURCE_NAME}-zhangsan-001`} />
            </Form.Item>

            <Form.Item label="CPU 颗数" name="cpu_number" initialValue={1}>
              <Slider min={1} max={4} step={null} marks={{ 1: '1', 2: '2', 4: '4' }} />
            </Form.Item>

            <Form.Item label="内存 (GB)" name="memory" initialValue={8}>
              <Slider
                min={8}
                max={32}
                marks={{ 8: '8GB', 16: '16GB', 32: '32GB' }}
                tooltip={{ formatter: (v) => `${v} GB` }}
              />
            </Form.Item>

            <Form.Item label="CPU 核数" name="cpu_core" initialValue={4}>
              <Slider min={4} max={16} step={null} marks={{ 4: '4', 8: '8', 16: '16' }} />
            </Form.Item>

            <Form.Item label="磁盘 (GB)" name="disk" initialValue={80}>
              <Slider
                min={80}
                max={500}
                marks={{ 80: '80GB', 200: '200GB', 350: '350GB', 500: '500GB' }}
                tooltip={{ formatter: (v) => `${v} GB` }}
              />
            </Form.Item>

            <Form.Item label="创建数量" name="count" initialValue={1} rules={[{ required: true }]}>
              <InputNumber min={1} max={10} style={{ width: '100%' }} />
            </Form.Item>
          </Form>
        </Spin>
      </Modal>
    </Card>
  );
};

export default VirtualMachineListSimplified;
