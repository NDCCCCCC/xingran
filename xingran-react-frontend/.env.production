# 生产环境配置

# 构建期子路径前缀。腾讯云 nginx 将后端代理到 /xingran/ 下,
# 因此构建产物中所有资源/路由引用都须带此前缀,才能匹配 location /xingran/
# 并被 nginx 剥前缀后转发到后端根路径。dev 环境不读此文件,base 默认 '/',行为不变。
# 与 VITE_API_BASE_URL 同步 — 浏览器发出的 URL 一律含 /xingran/ 前缀。
VITE_BASE=/xingran/

# API 地址（构建时配置）：前缀与 VITE_BASE 对齐,所有 axios 实例的
# baseURL 在生产构建下自动含 /xingran/。
VITE_API_BASE_URL=/xingran/api/v1

# 请求体加密开关（生产环境启用）
VITE_ENABLE_REQUEST_ENCRYPTION=true

# 百度地图 AK（用于楼宇空间 3D 可视化）
# 请在百度地图开放平台申请：https://lbsyun.baidu.com/
# 免费额度：5万次/日
VITE_BAIDU_MAP_AK=your_baidu_map_ak_here
