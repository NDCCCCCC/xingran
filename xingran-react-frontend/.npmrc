# PR #3 dev-deps bump brings in eslint@10.0.0+ which has a peer
# range narrower than what eslint-plugin-react@7.37.5 (still latest
# published) declares (\"^3 || ^4 || ^5 || ^6 || ^7 || ^8 || ^9.7\").
# Until eslint-plugin-react ships an eslint-10-compatible release we
# must install with --legacy-peer-deps. Local installs and `npm ci`
# in CI both need the same flag for reproducibility.
#
# Tracking the ecosystem fix: eslint-plugin-react has not published a
# release that supports eslint 10 as of 2026-08. Re-test and remove
# this file once a compatible version ships.
legacy-peer-deps=true
