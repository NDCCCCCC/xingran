# 本地构建版 Dockerfile
# 使用方法：
# 1. 在服务器上先构建二进制: CGO_ENABLED=0 go build -o rpa-worker ./cmd/main.go
# 2. 使用此 Dockerfile 打包: docker build -f Dockerfile.local -t rpa-worker:latest .

FROM ubuntu:22.04

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive

# 安装 Chromium 浏览器和依赖库
RUN apt-get update && apt-get install -y \
    ca-certificates \
    wget \
    gnupg \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-roboto \
    fonts-noto \
    xdg-utils \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libwayland-client0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxshmfence1 \
    libxtst6 \
    chromium-browser \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/chrome/.cache/rod \
    && mkdir -p /home/chrome/Downloads \
    && mkdir -p /app/screenshots \
    && chmod -R 777 /home/chrome

WORKDIR /app

# 复制本地构建的二进制文件
COPY rpa-worker .
COPY configs/config.yaml ./configs/

# Rod 浏览器缓存配置
ENV HOME=/home/chrome
ENV XDG_CACHE_HOME=/home/chrome/.cache
ENV XDG_RUNTIME_DIR=/tmp

# Chrome 路径配置
ENV CHROME_BIN=/usr/bin/chromium-browser
ENV CHROMIUM_PATH=/usr/bin/chromium-browser

# 健康检查端点
EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# 运行应用
CMD ["./rpa-worker", "-config", "configs/config.yaml"]
