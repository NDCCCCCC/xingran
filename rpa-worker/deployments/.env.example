# RPA Worker Docker 环境变量配置模板
# 复制此文件为 .env 并根据需要修改配置

# ==================== Worker 配置 ====================
WORKER_ID=worker-1
WORKER_NAME=rpa-worker-1
MAX_CONCURRENCY=5

# ==================== 后端 API 配置 ====================
# 后端 API 地址（使用实际服务器地址）
BACKEND_URL=http://10.62.10.34:9000/api/v1
# API Token (如果需要)
WORKER_TOKEN=

# ==================== Redis 配置 ====================
# 外部 Redis 地址（与后端共用）
REDIS_ADDR=10.62.10.34:6379
# Redis 密码（与后端配置一致）
REDIS_PASSWORD=)(PO09po
# Redis DB 编号
REDIS_DB=0

# ==================== Chrome 配置 ====================
# 是否无头模式（true/false）
HEADLESS=true
# Chrome 可执行文件路径（Docker中自动设置）
CHROME_BIN=/usr/bin/chromium-browser
CHROME_PATH=/usr/bin/chromium-browser
# Chrome 启动参数
CHROME_FLAGS=--no-sandbox --headless=new --disable-gpu --disable-dev-shm-usage

# ==================== 日志配置 ====================
# 日志级别: debug, info, warn, error
LOG_LEVEL=info
# 日志格式: json, console
LOG_FORMAT=json

# ==================== 资源限制 ====================
# 共享内存大小（Chrome需要）
SHM_SIZE=2gb

# ==================== 其他配置 ====================
# 健康检查端口
HEALTH_PORT=8080
# Chrome 调试端口（可选）
CHROME_DEBUG_PORT=9222
